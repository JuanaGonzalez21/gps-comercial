# Copy to frontend/.env.local. Vite embeds VITE_* values in the public bundle: no secrets here.
# Empty = same origin (recommended): /api and /health go through the dev proxy or the host rewrite.
VITE_API_BASE_URL=
# Backend that the Vite dev/preview proxy forwards /api and /health to.
VITE_DEV_PROXY_TARGET=http://localhost:8000
