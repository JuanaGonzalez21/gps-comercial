# Copy to backend/.env for local development. Never commit backend/.env.
# Every variable is documented in docs/api-contract.md section 8.
APP_ENV=development
LOG_LEVEL=INFO
# Empty = interactive docs (/docs) enabled except in production.
API_DOCS_ENABLED=

# Explicit frontend origins, comma-separated. Never "*".
CORS_ORIGINS=http://localhost:5173

# SQLite for a quick local run; PostgreSQL (postgresql://...) is required in production.
DATABASE_URL=sqlite:///./gps_comercial.db

# Signing secret for access tokens (>= 32 characters). Required in production; never commit it.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Empty = Secure cookies only in production.
COOKIE_SECURE=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Fleet platform: "wialon" (real) or "fake" (simulated data for local UI work; forbidden in production).
FLEET_GATEWAY=wialon
# Fixed Wialon host (not a secret).
WIALON_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
# Paste the private token only in backend/.env, never here, in chat, or in commits.
WIALON_TOKEN=
WIALON_TIMEOUT_SECONDS=15
WIALON_CACHE_TTL_SECONDS=15
# Optional: resource where new drivers/passengers are created. Empty = first available resource.
WIALON_DEFAULT_RESOURCE_ID=

# Derived vehicle status thresholds.
VEHICLE_MOVING_SPEED_KMH=5
VEHICLE_NO_SIGNAL_AFTER_MINUTES=60

# Initial admin, only read by: uv run python -m app.cli seed-admin
# No defaults: set them in backend/.env or in the hosting provider, never in Git.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
